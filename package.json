{
  "name": "path-serializer",
  "version": "0.7.0",
  "type": "module",
  "description": "path-serializer",
  "keywords": [
    "snapshot",
    "rstest",
    "vitest",
    "jest",
    "ci",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/path-serializer.git"
  },
  "license": "MIT",
  "author": "sooniter",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks && pnpm run build",
    "prepublish": "pnpm run build",
    "test": "rs test",
    "test:watch": "rs test --watch"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@rslib/core": "~1.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.1",
    "lodash-es": "^4.17.21",
    "rsbuild-plugin-publint": "^1.0.0",
    "rstack": "^0.7.2",
    "typescript": "^7.0.2",
    "upath": "^2.0.1"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
